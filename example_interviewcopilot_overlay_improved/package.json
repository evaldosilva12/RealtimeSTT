{
  "name": "interview-copilot-overlay",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop always-on-top overlay for Interview Copilot.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.interviewcopilot.overlay",
    "productName": "Interview Copilot Overlay",
    "files": [
      "**/*",
      "!interview_runtime.sqlite3*",
      "!realtimesst.log",
      "!tmp/**",
      "!__pycache__/**"
    ],
    "win": {
      "target": "portable"
    }
  }
}
